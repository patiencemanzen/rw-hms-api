# Runtime environment: development | test | production
NODE_ENV=development
# Port the API listens on (routes are served under /api/v1)
PORT=4000
# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Exact origin of the Next.js frontend allowed by CORS (must be https in production)
FRONTEND_ORIGIN=http://localhost:3000
# Serve Swagger UI at /api/docs (always off in production unless explicitly true)
SWAGGER_ENABLED=true

# PostgreSQL connection string (docker-compose exposes Postgres on 5433)
DATABASE_URL=postgres://rwhms:rwhms_dev_password@localhost:5433/rw_hms

# Secrets: generate each one with `openssl rand -base64 48`. Min 32 chars, all three different.
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-output-1
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48-output-2
COOKIE_SECRET=replace-with-openssl-rand-base64-48-output-3
# Access token lifetime in seconds (15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7

# SMTP (Mailpit in development: UI at http://localhost:8025, no credentials)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Rw-HMS <no-reply@rwhms.local>"

# Reverse proxies in front of the API, so rate limits and audit logs see the real client IP:
# false when reached directly, 2 for Vercel rewrite -> Render (see render.yaml)
TRUST_PROXY=false

# S3-compatible object storage (MinIO in development, console at http://localhost:9001).
# Optional until document uploads ship: set all of endpoint/keys/bucket, or leave all four out.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rwhms_minio
S3_SECRET_KEY=rwhms_minio_dev_password
S3_BUCKET=rw-hms-documents

# Password given to every seeded user (local development only; seed refuses to run in production)
SEED_DEFAULT_PASSWORD=ChangeMe!Dev2026

# Production first run only: `npm run db:bootstrap` creates this facility and Super Admin
# (who then sets a password via "Forgot password"). Safe to re-run.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_FACILITY_CODE=
# BOOTSTRAP_FACILITY_NAME=
# BOOTSTRAP_FACILITY_LEVEL=          # HEALTH_POST | HEALTH_CENTER | DISTRICT | PROVINCIAL | REFERRAL | NATIONAL_REFERRAL
# BOOTSTRAP_FACILITY_PROVINCE=       # KIGALI_CITY | NORTHERN | SOUTHERN | EASTERN | WESTERN
# BOOTSTRAP_FACILITY_DISTRICT=
# BOOTSTRAP_REFERENCE_DATA=false     # true loads the starter admin-area and ICD-10 lists
